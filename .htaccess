Options -Indexes
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(config|database|src|node_modules|legacy)/ - [F,L,NC]
</IfModule>
<FilesMatch "^(\.env|package(-lock)?\.json|vite\.config\.js)$">
  Require all denied
</FilesMatch>
